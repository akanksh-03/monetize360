{
  "domain": "parking",
  "base_price_field": "base_price",
  "rules": [
    {
      "id": "pk_001",
      "description": "High occupancy adjustment",
      "conditions": [
        {
          "field": "occupancy",
          "op": ">",
          "value": 0.8
        }
      ],
      "action": {
        "type": "percent_increase",
        "value": 25
      },
      "priority": 1
    },
    {
      "id": "pk_002",
      "description": "Nearby event adjustment",
      "conditions": [
        {
          "field": "event_active",
          "op": "==",
          "value": true
        }
      ],
      "action": {
        "type": "flat_add",
        "value": 20
      },
      "priority": 2
    }
  ],
  "constraints": {
    "max_multiplier": 2,
    "min_multiplier": 0.5
  },
  "studio": {
    "label": "Smart parking",
    "currency": "INR",
    "timezone": "Asia/Kolkata",
    "description": "A fourth domain imported entirely from configuration. Example business assumptions.",
    "fields": {
      "base_price": {
        "label": "Hourly base rate",
        "type": "number",
        "default": 60,
        "min": 0,
        "required": true,
        "unit": "INR"
      },
      "occupancy": {
        "label": "Occupied spaces",
        "type": "number",
        "default": 0.9,
        "min": 0,
        "max": 1,
        "step": 0.01,
        "required": true
      },
      "event_active": {
        "label": "Nearby event",
        "type": "boolean",
        "default": true,
        "required": true
      }
    }
  }
}